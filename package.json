{
  "name": "homebridge-broadlink-hub",
  "displayName": "BroadLink Hub",
  "version": "0.1.1",
  "description": "Fast, reliable Apple Home control for BroadLink RM remotes (RM mini, RM Pro, RM4, RM4 Pro): switches, lights, fans, TVs, air conditioners and more over IR and RF, with code learning in the Homebridge UI. Drop-in successor to homebridge-broadlink-rm.",
  "license": "Apache-2.0",
  "author": "pirates-killer",
  "homepage": "https://github.com/pirates-killer/homebridge-broadlink-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pirates-killer/homebridge-broadlink-hub.git"
  },
  "bugs": {
    "url": "https://github.com/pirates-killer/homebridge-broadlink-hub/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "broadlink",
    "rm4",
    "rm4 pro",
    "rm mini",
    "rm pro",
    "infrared",
    "ir",
    "rf",
    "remote",
    "air conditioner",
    "tv"
  ],
  "main": "index.js",
  "files": [
    "index.js",
    "platform.js",
    "accessories",
    "base",
    "helpers",
    "lib",
    "homebridge-ui",
    "config.schema.json",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^20.18.0 || ^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "test": "mocha --exit --require test/known-legacy-failures.js \"test/**/*.test.js\"",
    "test:core": "mocha --exit test/protocol.test.js test/persistence.test.js",
    "test:e2e": "node test/e2e/hb2-smoke.js",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepublishOnly": "npm run lint && npm test"
  },
  "dependencies": {
    "fakegato-history": "^0.6.7",
    "mqtt": "^5.14.0",
    "@homebridge/plugin-ui-utils": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "eslint-plugin-no-autofix": "^1.2.3",
    "globals": "^16.3.0",
    "mocha": "^11.7.1",
    "chai": "^4.3.7",
    "@homebridge/hap-nodejs": "2.3.0",
    "homebridge": "2.5.0"
  }
}
